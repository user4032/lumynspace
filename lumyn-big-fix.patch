From 9d5d577ca3826b41a566b3921c3435801e4d510b Mon Sep 17 00:00:00 2001
From: Grok <grok@x.ai>
Date: Sun, 11 Oct 2026 21:46:27 +0000
Subject: [PATCH 2/3] fix: profile nav link no longer falls back to mock
 username

---
 src/components/layout/nav-items.ts | 12 ++++++++----
 src/components/layout/sidebar.tsx  |  2 +-
 2 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/src/components/layout/nav-items.ts b/src/components/layout/nav-items.ts
index aa888be..34e684a 100644
--- a/src/components/layout/nav-items.ts
+++ b/src/components/layout/nav-items.ts
@@ -27,14 +27,18 @@ export const navItems: NavItem[] = [
   { href: "/communities", label: "Спільноти", icon: Users, shortcut: "G C" },
   { href: "/messages", label: "Повідомлення", icon: MessageSquare, badge: isMockMode ? 3 : undefined, shortcut: "G M" },
   { href: "/notifications", label: "Сповіщення", icon: Bell, badge: isMockMode ? 4 : undefined, shortcut: "G N" },
-  { href: `/${currentUser.username}`, label: "Профіль", icon: User, shortcut: "G P", me: true },
   { href: "/settings", label: "Налаштування", icon: Settings, shortcut: "G S" },
+  // Профіль: href підставляється в withMyProfile. Поки нік невідомий — веде в нікуди (не на мок).
+  { href: "#", label: "Профіль", icon: User, shortcut: "G P", me: true },
 ]
 
-/** Профіль веде на мій справжній нік (із Supabase він відомий лише після завантаження) */
+/** Профіль веде на мій справжній нік. Поки нік не завантажений — лінк неактивний. */
 export function withMyProfile(items: NavItem[], username: string): NavItem[] {
-  if (isMockMode || !username) return items
-  return items.map((i) => (i.me ? { ...i, href: `/${username}` } : i))
+  return items.map((i) => {
+    if (!i.me) return i
+    if (!username) return { ...i, href: "#", label: "Профіль" }
+    return { ...i, href: `/${username}` }
+  })
 }
 
 /** Supabase: живі лічильники непрочитаного на «Повідомлення» / «Сповіщення» */
diff --git a/src/components/layout/sidebar.tsx b/src/components/layout/sidebar.tsx
index a7ad53f..01677a5 100644
--- a/src/components/layout/sidebar.tsx
+++ b/src/components/layout/sidebar.tsx
@@ -84,7 +84,7 @@ export function Sidebar() {
       </Button>
 
       <Link
-        href={`/${me.username}`}
+        href={me.username ? `/${me.username}` : "#"}
         className="mt-auto flex items-center gap-3 rounded-md p-2 transition-colors hover:bg-muted max-xl:justify-center"
       >
         <UserAvatar user={me} size="md" showOnline />
-- 
