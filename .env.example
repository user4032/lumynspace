# Supabase → Project Settings → API (або кнопка «Connect»)
# Без цих змінних застосунок працює в демо-режимі на мок-даних.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Необов'язково: публічна адреса сайту (для OG-картинок і метаданих)
# NEXT_PUBLIC_SITE_URL=https://lumin.vercel.app

# Необов'язково: «Зараз грає» з Last.fm (https://www.last.fm/api/account/create), лише на сервері
# LASTFM_API_KEY=

# Web Push (VAPID) — згенерувати: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
